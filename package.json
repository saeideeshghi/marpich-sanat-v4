{
  "name": "marpich-sanat",
  "version": "4.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "customize": "node scripts/start-customizer.js",
    "build": "vite build",
    "build:backend": "vite build --mode backend && node scripts/check-backend.js",
    "preview": "vite preview",
    "preview:backend": "vite preview --mode backend",
    "check": "node scripts/check-project.js && node scripts/check-components.js && node scripts/check-certificate-assets.js && node scripts/check-pattern-motion.js && node scripts/check-handoff.js && node scripts/check-customizer.js && node scripts/check-view-tools.js && node scripts/check-token-editor.js && node scripts/check-platform.js",
    "check:assets": "node scripts/check-assets.js",
    "check:security": "node scripts/check-security.js && node scripts/check-svg.js",
    "check:release": "npm run check && npm run check:localization && npm run check:security && npm run check:assets && npm run check:performance && npm run format:check",
    "check:performance": "node scripts/check-performance.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean:legacy": "node scripts/clean-legacy.js",
    "tokens:refresh": "node scripts/refresh-tokens.js",
    "check:build": "node scripts/check-build.js",
    "check:localization": "node scripts/check-localization.js",
    "check:browser:locales": "node scripts/check-browser-locales.js",
    "build:pages": "vite build --mode pages && node scripts/check-build.js --pages",
    "preview:pages": "vite preview --mode pages"
  },
  "devDependencies": {
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "subset-font": "2.9.0",
    "vite": "^8.3.3",
    "wawoff2": "^2.0.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
